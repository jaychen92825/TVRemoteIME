<?xml version="1.0" encoding="utf-8"?>
<!-- 之前竖屏/横屏各有一份布局(横屏两栏)，因为原来有6个卡片，单列在窄屏
     下会拖得很长。DLNA名称挪到顶栏、访问口令去掉按钮变自动生效、检查更新
     变成顶栏的图标按钮之后，只剩3个卡片，内容短了很多，不再需要为了控制
     总高度专门做一份横屏两栏布局——两份文件保持id完全一致这件事本身还是
     持续的维护负担(之前就因为漏同步一个id导致横屏必崩)，合并成一份更省心。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context="com.android.tvremoteime.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- 自定义顶部标题，替代系统标题栏。DLNA投屏名称本来自己占一整个
             卡片，但它就是个"改个名字"的简单操作，跟App名称/版本号放
             同一行、点开输入框直接改，改完移开焦点自动生效，不需要单独
             一块地方也不需要额外的"设置"按钮。检查更新同理，从一整个
             卡片(标题+状态文字+按钮)缩成版本号后面一个图标按钮，点了
             有结果用Toast提示，不需要常驻一行状态文字占地方。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:gravity="bottom"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:text=""/>
            <!-- 之前用文字按钮显示"↻"字符，清零了padding/includeFontPadding
                 之后按钮本身大小是对的，但"↻"这个字形在系统字体里左右
                 两侧留白不对称(箭头集中在右下)，导致图标视觉上还是偏，
                 这不是padding能解决的问题。换成ImageButton+矢量图标后，
                 图标是按精确路径画的正方形图形，天然居中，不再受字体
                 字形影响。 -->
            <ImageButton
                android:id="@+id/btnCheckUpdate"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_button"
                android:src="@drawable/ic_refresh"
                android:contentDescription="@null"
                android:nextFocusDown="@id/etDLNAName"
                android:onClick="onClick"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="8dp"
                android:text="设备名"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>
            <EditText
                android:id="@+id/etDLNAName"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit"
                android:hint="如：客厅、卧室"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:nextFocusUp="@id/btnCheckUpdate"
                android:nextFocusDown="@id/btnUseIME"/>
        </LinearLayout>

        <!-- ① 启用输入法服务 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="① 启用输入法"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:text="启用输入法"/>
                <TextView
                    android:id="@+id/tvIMEEnabledStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:textSize="14sp"
                    android:text=""/>
                <Button
                    android:id="@+id/btnUseIME"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_button"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="设置"
                    android:textColor="@color/white"
                    android:nextFocusUp="@id/etDLNAName"
                    android:nextFocusDown="@id/btnSetIME"
                    android:onClick="onClick"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:text="设为默认输入法"/>
                <TextView
                    android:id="@+id/tvIMEDefaultStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:textSize="14sp"
                    android:text=""/>
                <Button
                    android:id="@+id/btnSetIME"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_button"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="设置"
                    android:textColor="@color/white"
                    android:nextFocusUp="@id/btnUseIME"
                    android:nextFocusDown="@id/etAccessCode"
                    android:onClick="onClick"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ② 打开手机遥控界面：标题、文案都改成"照着做就行"的说明语气，
             不用"连接控制端"这种技术说法——用户不需要理解"控制端"是什么，
             只需要知道"扫这个码，或者在手机浏览器里输入这个地址，密码是
             这个"。地址不再区分"IP地址"/"固定地址"这两个技术上不同、
             但对用户来说都是"随便试一个能用的地址"的东西，统一用"或者"
             连接展示，先给一个好记的域名，再给一个备用的。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="② 打开手机遥控界面"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <!-- 扫码/手动输入是两种"打开界面"的等价选项，放一行左右并列；
                 密码本质上是"手动输入地址"这条路径才用得上的东西(扫码
                 登录不用管密码)，跟地址放在同一栏里、紧接在地址下面，
                 不需要单独占一整行卡片宽度、也不需要用分割线特意隔开
                 成一个独立小节。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="扫码打开"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"/>
                    <ImageView
                        android:id="@+id/ivQRCode"
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:background="@color/white"
                        android:padding="6dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="或者，手机浏览器里输入："
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="@color/text_primary"
                        android:textIsSelectable="true"
                        android:textSize="14sp"
                        android:text=""/>
                    <!-- 密码：跟DLNA名称一样，改成输入框失焦自动生效，不需要
                         单独一个"修改"按钮；留空表示登录不需要密码。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="8dp"
                            android:text="密码"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"/>
                        <EditText
                            android:id="@+id/etAccessCode"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit"
                            android:hint="留空则不需要密码"
                            android:inputType="text"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="13sp"
                            android:nextFocusUp="@id/btnSetIME"
                            android:nextFocusDown="@id/btnStartService"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 手动启动/重启服务：本质是"手机连不上就点它试试"，跟IME是否
             已经是默认输入法没关系(即使已经是默认，服务也可能因为别的
             原因没跑起来)，之前只在没设完默认输入法时才显示，反而在
             最需要它的"配置早就弄好了、突然连不上"场景里找不到它。挪到
             连接控制端后面、常驻显示，位置上更贴近"连接不上"这个使用
             场景，图标+文字的小按钮，不需要单独一整块卡片。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="手机连不上？"/>
            <Button
                android:id="@+id/btnStartService"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_button"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="▶ 重启服务"
                android:textColor="@color/white"
                android:nextFocusUp="@id/etAccessCode"
                android:nextFocusDown="@id/etTestInput"
                android:onClick="onClick"/>
        </LinearLayout>

        <!-- ③ 测试远程输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="③ 测试远程输入"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etTestInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_edit"
                android:hint="点此，用手机在控制端输入试试"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:nextFocusUp="@id/btnStartService"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
