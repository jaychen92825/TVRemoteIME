<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context="com.android.tvremoteime.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ① 启用输入法服务 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="① 启用输入法服务"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:text="@string/step1"/>
                <Button
                    android:id="@+id/btnUseIME"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_button"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="设置"
                    android:textColor="@color/white"
                    android:onClick="onClick"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:text="@string/step2"/>
                <Button
                    android:id="@+id/btnSetIME"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_button"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="设置"
                    android:textColor="@color/white"
                    android:onClick="onClick"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:text="如果无法设为系统默认输入法，点击手动启动服务（需开启系统ADB模式才能使用远程输入/遥控）"/>
                <Button
                    android:id="@+id/btnStartService"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_button"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="手动启动"
                    android:textColor="@color/white"
                    android:onClick="onClick"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ② 连接控制端 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="② 连接控制端"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="手机/电脑扫描二维码自动登录，或手动访问下方地址"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivQRCode"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@color/white"
                    android:padding="6dp"/>
                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:text=""/>
            </LinearLayout>
        </LinearLayout>

        <!-- ③ 访问口令 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="③ 修改访问口令"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="口令用于控制端登录鉴权，默认随机生成；也可以改成你自己方便记的（改成越简单的口令，被同一局域网内其他人/设备访问的风险也越高，请自行权衡）"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/etAccessCode"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:hint="输入新口令"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"/>
                <Button
                    android:id="@+id/btnSetAccessCode"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_button"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="修改"
                    android:textColor="@color/white"
                    android:onClick="onClick"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ④ 测试远程输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="④ 测试远程输入"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <EditText
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_edit"
                android:hint="点此，用手机在控制端输入试试"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>
        </LinearLayout>

        <!-- ⑤ DLNA投屏名称 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="⑤ DLNA投屏名称"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/etDLNAName"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:hint="如：客厅、卧室（留空则不加后缀）"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"/>
                <Button
                    android:id="@+id/btnSetDLNA"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_button"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="设置"
                    android:textColor="@color/white"
                    android:onClick="onClick"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
