<?xml version="1.0" encoding="utf-8"?>
<!-- 之前这里是9-patch位图(key_focused/key_normal/key_pressed.9.png)画出来的
     立体浮雕按键，年代感很重。改成用shape直接画：焦点态是主题蓝的浅色底+
     描边(呼应遥控器方向盘的焦点样式)，按下态是纯色深蓝，平时是跟键盘背景
     区分开的深灰。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#2E3EA6FF" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/accent_pressed" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/key_bg" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
