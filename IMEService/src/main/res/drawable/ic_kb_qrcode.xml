<?xml version="1.0" encoding="utf-8"?>
<!-- 原来的net_icon(网络图标)换成更直白的二维码图标——按这个键弹出的就是
     扫码连接的窗口，图标本身直接对应"扫码"这个动作，不需要用户先理解
     "网络"这个抽象概念再联想到"哦原来是连接方式"。跟web控制端的
     "应用管理"格子图标同一个视觉语言(左上/右上/左下三个定位角方块)，
     但补上了右下角几个小方块，让它更像一枚真正的二维码而不是四宫格。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/text_primary">
    <path
        android:pathData="M3 3h7v7h-7z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:fillColor="#00000000" />
    <path
        android:pathData="M14 3h7v7h-7z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:fillColor="#00000000" />
    <path
        android:pathData="M3 14h7v7h-7z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:fillColor="#00000000" />
    <path android:fillColor="#FF000000" android:pathData="M14 14h3v3h-3z"/>
    <path android:fillColor="#FF000000" android:pathData="M18 14h3v3h-3z"/>
    <path android:fillColor="#FF000000" android:pathData="M14 18h3v3h-3z"/>
    <path android:fillColor="#FF000000" android:pathData="M18 18h3v3h-3z"/>
</vector>
