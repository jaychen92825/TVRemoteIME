<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/play_list_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="14dp">

    <LinearLayout
        android:id="@+id/iv_playing_state_img"
        android:layout_width="24dp"
        android:layout_height="24dp">

        <ImageView
            android:id="@+id/iv_playing_state"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_playing_state"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_playing_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingLeft="12dp"
        android:text="this is a name..."
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_playing_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:text="20M"
        android:textColor="@color/Grey_400"
        android:textSize="13sp" />
</LinearLayout>
